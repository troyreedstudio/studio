# LMC client environment — TEMPLATE. Copy to .env and fill with real values.
# .env is gitignored; NEVER commit real keys. Only the anon key belongs on the
# client (it is RLS-protected). The service-role key must NEVER appear here.
#
# Also register every EXPO_PUBLIC_* value as an EAS env var, or it resolves null
# in TestFlight builds (the Mapbox blank-map class of bug).

# Supabase project URL — Dashboard > Project Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon public key — Dashboard > Project Settings > API > anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
