# LMC client environment — TEMPLATE. Copy to .env and fill with real values.
# .env is gitignored; NEVER commit real keys. Only the anon key belongs on the
# client (it is RLS-protected). The service-role key must NEVER appear here.
#
# Also register every EXPO_PUBLIC_* value as an EAS env var, or it resolves null
# in TestFlight builds (the Mapbox blank-map class of bug).

# Supabase project URL — Dashboard > Project Settings > API > Project URL
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase anon public key — Dashboard > Project Settings > API > anon public
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ─── Google Sign-In (native idToken → Supabase) ───────────────────────────────
# Create OAuth 2.0 Client IDs in Google Cloud Console > Credentials.
# The WEB client ID is the audience Supabase verifies against (also set it as the
# Google "Authorized Client ID" in Supabase Auth > Providers > Google).
# The iOS client ID is what the native @react-native-google-signin SDK uses.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR-WEB-CLIENT-ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR-IOS-CLIENT-ID.apps.googleusercontent.com
